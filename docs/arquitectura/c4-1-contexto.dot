digraph G { rankdir=TB; nodesep=0.6; ranksep=0.8; bgcolor="white"; fontname="Helvetica"; labelloc=t; label=<<b>C4 · Nivel 1 — Diagrama de contexto de ReciApp</b>>; fontsize=18; node[width=2.6]; 
ciu [shape=box style="rounded,filled" fillcolor="#08427b" fontcolor="white" color="#073b6f" fontname="Helvetica" margin="0.25,0.15" label=<<b>Ciudadano</b><br/><font point-size="10">[Persona]</font><br/><br/><font point-size="10">Vecino que separa residuos y<br/>programa recojos por voz o toque.<br/>Incluye adultos mayores y<br/>personas con discapacidad.</font>>];
rec [shape=box style="rounded,filled" fillcolor="#08427b" fontcolor="white" color="#073b6f" fontname="Helvetica" margin="0.25,0.15" label=<<b>Reciclador</b><br/><font point-size="10">[Persona]</font><br/><br/><font point-size="10">Reciclador formal que toma<br/>solicitudes y registra evidencias.</font>>];
adm [shape=box style="rounded,filled" fillcolor="#08427b" fontcolor="white" color="#073b6f" fontname="Helvetica" margin="0.25,0.15" label=<<b>Administrador</b><br/><font point-size="10">[Persona]</font><br/><br/><font point-size="10">Valida recicladores y supervisa.</font>>];
app [shape=box style="rounded,filled" fillcolor="#1168bd" fontcolor="white" color="#1168bd" fontname="Helvetica" margin="0.25,0.15" label=<<b>ReciApp</b><br/><font point-size="10">[Sistema de software]</font><br/><br/><font point-size="10">PWA de reciclaje con asistente de voz,<br/>perfil adaptativo y salas colaborativas.</font>>];
llm [shape=box style="rounded,filled" fillcolor="#999999" fontcolor="white" color="#999999" fontname="Helvetica" margin="0.25,0.15" label=<<b>Proveedor LLM</b><br/><font point-size="10">[Sistema externo]</font><br/><br/><font point-size="10">OpenAI / Groq / Anthropic / Gemini<br/>u Ollama local (intercambiable).</font>>];
osm [shape=box style="rounded,filled" fillcolor="#999999" fontcolor="white" color="#999999" fontname="Helvetica" margin="0.25,0.15" label=<<b>OpenStreetMap</b><br/><font point-size="10">[Sistema externo]</font><br/><br/><font point-size="10">Teselas del mapa y grafo vial<br/>(Overpass) para rutas.</font>>];
web [shape=box style="rounded,filled" fillcolor="#999999" fontcolor="white" color="#999999" fontname="Helvetica" margin="0.25,0.15" label=<<b>Web Speech API</b><br/><font point-size="10">[Sistema externo]</font><br/><br/><font point-size="10">Reconocimiento y síntesis de voz<br/>del navegador / sistema operativo.</font>>];
{rank=same; ciu; rec; adm}
ciu -> app [label=<<font point-size="9">Programa recojos, conversa con Reci,<br/>participa en salas</font><br/><font point-size="8">[HTTPS/WSS]</font>> color="#707070" fontcolor="#404040" fontname="Helvetica"];
rec -> app [label=<<font point-size="9">Toma solicitudes, navega,<br/>sube evidencia</font><br/><font point-size="8">[HTTPS/WSS]</font>> color="#707070" fontcolor="#404040" fontname="Helvetica"];
adm -> app [label=<<font point-size="9">Valida recicladores</font><br/><font point-size="8">[HTTPS]</font>> color="#707070" fontcolor="#404040" fontname="Helvetica"];
app -> llm [label=<<font point-size="9">Interpreta intención y redacta<br/>respuestas (JSON)</font><br/><font point-size="8">[HTTPS]</font>> color="#707070" fontcolor="#404040" fontname="Helvetica"];
app -> osm [label=<<font point-size="9">Mapas y cálculo de rutas</font><br/><font point-size="8">[HTTPS]</font>> color="#707070" fontcolor="#404040" fontname="Helvetica"];
app -> web [label=<<font point-size="9">STT es-PE / TTS</font><br/><font point-size="8">[API del navegador]</font>> color="#707070" fontcolor="#404040" fontname="Helvetica"];
}
digraph G { rankdir=TB; nodesep=0.6; ranksep=0.8; bgcolor="white"; fontname="Helvetica"; labelloc=t; label=<<b>C4 · Nivel 2 — Diagrama de contenedores</b>>; fontsize=18; node[width=2.6]; 
u [shape=box style="rounded,filled" fillcolor="#08427b" fontcolor="white" color="#073b6f" fontname="Helvetica" margin="0.25,0.15" label=<<b>Ciudadano / Reciclador</b><br/><font point-size="10">[Persona]</font><br/><br/><font point-size="10">Usa la app en laptop o celular</font>>];
subgraph cluster_app { label=<<b>ReciApp</b>>; style="dashed"; color="#1168bd"; fontcolor="#1168bd"; pwa [shape=box style="rounded,filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>PWA (SPA)</b><br/><font point-size="10">[React 18 + Vite]</font><br/><br/><font point-size="10">UI, asistente Reci, voz (Web Speech),<br/>perfil y salas. Instalable.</font>>]; sw [shape=box style="rounded,filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>Service Worker</b><br/><font point-size="10">[JavaScript]</font><br/><br/><font point-size="10">Caché del app shell, API y teselas;<br/>funcionamiento offline.</font>>]; api [shape=box style="rounded,filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>API REST + WebSocket</b><br/><font point-size="10">[FastAPI (Python 3.12)]</font><br/><br/><font point-size="10">Auth JWT, solicitudes, asignación,<br/>asistente, perfil adaptativo, salas.</font>>]; llm [shape=box style="rounded,filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>Capa de abstracción LLM</b><br/><font point-size="10">[Python · app/llm]</font><br/><br/><font point-size="10">Fábrica de proveedores + NLU local<br/>de respaldo (offline).</font>>]; db [shape=cylinder style="filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>Base de datos</b><br/><font point-size="10">[PostgreSQL 16 / SQLite]</font><br/><br/><font point-size="10">Usuarios, solicitudes, evidencias,<br/>perfiles JSON, salas y mensajes.</font>>]; fs [shape=folder style="rounded,filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>Almacén de evidencias</b><br/><font point-size="10">[Sistema de archivos /uploads]</font><br/><br/><font point-size="10">Fotos de recolección.</font>>]; }
ext [shape=box style="rounded,filled" fillcolor="#999999" fontcolor="white" color="#999999" fontname="Helvetica" margin="0.25,0.15" label=<<b>Proveedor LLM</b><br/><font point-size="10">[Sistema externo]</font><br/><br/><font point-size="10">Remoto u Ollama local</font>>];
osm [shape=box style="rounded,filled" fillcolor="#999999" fontcolor="white" color="#999999" fontname="Helvetica" margin="0.25,0.15" label=<<b>OpenStreetMap</b><br/><font point-size="10">[Sistema externo]</font><br/><br/><font point-size="10">Teselas + Overpass</font>>];

digraph G { rankdir=TB; nodesep=0.6; ranksep=0.8; bgcolor="white"; fontname="Helvetica"; labelloc=t; label=<<b>C4 · Nivel 3 — Componentes de la API (FastAPI)</b>>; fontsize=18; node[width=2.6]; 
pwa [shape=box style="rounded,filled" fillcolor="#438dd5" fontcolor="white" color="#3c7fc0" fontname="Helvetica" margin="0.22,0.12" label=<<b>PWA</b><br/><font point-size="10">[React]</font><br/><br/><font point-size="10">Cliente</font>>];
subgraph cluster_api { label=<<b>API REST + WebSocket</b>>; style="dashed"; color="#438dd5"; fontcolor="#438dd5"; auth [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Auth</b><br/><font point-size="9">[api/v1/auth.py]</font><br/><font point-size="9">Registro, login JWT</font>>]; sol [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Solicitudes</b><br/><font point-size="9">[api/v1/solicitudes.py]</font><br/><font point-size="9">Crear, tomar, aceptar,<br/>confirmar</font>>]; asg [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Asignación</b><br/><font point-size="9">[services/asignacion.py]</font><br/><font point-size="9">Reciclador más cercano<br/>con reintentos</font>>]; rut [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Ruteo</b><br/><font point-size="9">[services/ruteo.py]</font><br/><font point-size="9">Dijkstra sobre grafo OSM</font>>]; asis [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Asistente Reci</b><br/><font point-size="9">[services/asistente.py]</font><br/><font point-size="9">Orquesta NLU + LLM, tono,<br/>autocompletado y acciones</font>>]; fab [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Fábrica LLM</b><br/><font point-size="9">[llm/factory.py]</font><br/><font point-size="9">Proveedor activo +<br/>respaldo local</font>>]; nlu [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>NLU local</b><br/><font point-size="9">[llm/nlu.py]</font><br/><font point-size="9">Intención, slots, emoción<br/>(reglas es-PE)</font>>]; prov [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Proveedores</b><br/><font point-size="9">[llm/providers.py]</font><br/><font point-size="9">OpenAI-compat, Ollama,<br/>Anthropic, Gemini</font>>]; perf [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Perfil adaptativo</b><br/><font point-size="9">[services/perfil_adaptativo.py]</font><br/><font point-size="9">aplicar_evento() · derivar()<br/>(tono, ritmo, velocidad voz)</font>>]; imp [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Impacto</b><br/><font point-size="9">[services/impacto.py]</font><br/><font point-size="9">CO₂ evitado y niveles</font>>]; salas [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Salas</b><br/><font point-size="9">[api/v1/salas.py + services/salas.py]</font><br/><font point-size="9">Metas, ranking, chat,<br/>reacciones, logros</font>>]; ws [shape=box style="rounded,filled" fillcolor="#85bbf0" fontcolor="#0b2541" color="#78a8d8" fontname="Helvetica" margin="0.2,0.1" label=<<b>Gestor WebSocket</b><br/><font point-size="9">[websockets/manager.py]</font><br/><font point-size="9">Conexiones por usuario,<br/>difusión a miembros</font>>]; }

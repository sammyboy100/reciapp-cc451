# ── Base de datos ──────────────────────────────────────────────
# Docker:  postgresql://reciapp:reciapp@db:5432/reciapp
# Laptop sin Docker (más simple):  sqlite:///./reciapp.db
DATABASE_URL=postgresql://reciapp:reciapp@db:5432/reciapp
SECRET_KEY=dev-secret-key-reemplazar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=600
# Orígenes permitidos (CORS), separados por coma. 4173 = vite preview (PWA instalable)
FRONTEND_URL=http://localhost:5173,http://localhost:4173

# ── Capa LLM intercambiable ────────────────────────────────────
# local (offline, sin API key) | openai | groq | openrouter | ollama | anthropic | gemini
LLM_PROVIDER=local
LLM_MODEL=
LLM_API_KEY=
# Solo para servidores propios u Ollama (ej. http://localhost:11434/v1)
LLM_BASE_URL=
LLM_TIMEOUT=20
